{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.15.0/schemas/schema.json",
  "services": [
    {
      "product": "IPV-Core",
      "component": "ipv-core-back",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.detect-secrets"
          },
          "checks": [
            {
              "name": "secret scanning"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.test-java"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "unit"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.api-test"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "integration"
            },
            {
              "name": "regression"
            },
            {
              "name": "new feature"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/contract-tests.yaml"
          },
          "checks": [
            {
              "name": "contract"
            }
          ]
        }
      ]
    }
  ]
}
