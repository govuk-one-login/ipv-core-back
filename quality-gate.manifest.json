{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.13.0/schemas/schema.json",
  "services": [
    {
      "product": "IPV-Core",
      "component": "ipv-core-back",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": [
            "secret scanning"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.detect-secrets"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "unit test coverage",
            "unit"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.test-java"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "integration",
            "regression",
            "new feature"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/automated-tests.yaml",
            "path": "$.jobs.api-test"
          }
        },
        {
          "checkTypes": [
            "contract"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/contract-tests.yaml"
          }
        }
      ]
    }
  ]
}
