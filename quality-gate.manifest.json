{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.17.0/schemas/schema.json",
  "services": [
    {
      "product": "IPV-Core",
      "component": "ipv-core-back",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/automated-tests.yaml",
          "path": "$.jobs.detect-secrets"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "unit"
            }
          ],
          "file": ".github/workflows/automated-tests.yaml",
          "path": "$.jobs.test-java"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "integration",
              "purpose": [
                "regression",
                "new feature"
              ]
            }
          ],
          "file": ".github/workflows/automated-tests.yaml",
          "path": "$.jobs.api-test"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "contract"
            }
          ],
          "file": ".github/workflows/contract-tests.yaml"
        }
      ]
    }
  ]
}
